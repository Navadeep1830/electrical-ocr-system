# Local vs Cloud Configuration (Default: 100% Free Local Mode)
FORCE_LOCAL_OCR=true

# Local VLM & OCR Configuration (RTX 2050 GPU Optimized)
VLM_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
VLM_DEVICE=auto
PDF_RENDER_DPI=300
OLLAMA_API_URL=http://127.0.0.1:11434
